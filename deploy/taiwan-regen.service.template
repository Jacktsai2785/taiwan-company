# systemd user service 模板（長跑批次，自給自足、可續跑）。
# 由 scripts/bootstrap.sh 將 __REPO_DIR__ 替換成實際路徑後，
# 安裝到 ~/.config/systemd/user/taiwan-regen.service。
# 不要直接編輯安裝後的檔案——改這份 template 再重跑 bootstrap。
[Unit]
Description=台灣產業商情平台 - 競業表批次重生成（自給自足、撞用量上限自動等待、可續跑）
After=taiwan-company.service
Wants=taiwan-company.service

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=/usr/bin/bash __REPO_DIR__/scripts/regen_summaries.sh
# 腳本內部已會熬過用量上限（每 15 分重試），跑完即 exit 0；
# 只有「非正常退出」（crash）才重啟，正常跑完不重啟。開機時靠 enable 自動起。
Restart=on-failure
RestartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
